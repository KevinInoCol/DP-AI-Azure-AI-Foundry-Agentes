FOUNDRY_PROJECT_ENDPOINT="https://<recurso>.services.ai.azure.com/api/projects/<proyecto>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"

# Tool buscar_propiedades_alquiler (Google Sheets)
# ID de la hoja: parte de la URL entre /d/ y /edit
GOOGLE_SHEETS_ID="1AbC...xyz"
# Solo si la hoja NO es pública: contenido completo del JSON de la cuenta de servicio
# (y comparte la hoja con el email de esa cuenta).
